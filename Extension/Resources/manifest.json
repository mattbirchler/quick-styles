{
  "manifest_version": 3,
  "name": "Quick Styles",
  "description": "Add your own CSS to any website.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "19": "toolbar-19.png",
      "32": "toolbar-32.png",
      "38": "toolbar-38.png"
    },
    "default_title": "Quick Styles"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "activeTab"]
}
